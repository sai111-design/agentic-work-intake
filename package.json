{
  "name": "agentic-work-intake",
  "version": "1.0.0",
  "description": "Agentic Work Intake & Execution Prototype — turns unstructured work into a structured, reviewable, partially-automated workflow",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "init-db": "npm run build && node dist/db/init.js",
    "dev": "npm run build && node --env-file=.env dist/server.js",
    "start": "node dist/server.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:live": "npm run build && node --env-file=.env --test \"dist/tests-live/**/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
