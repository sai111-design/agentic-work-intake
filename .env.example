# Copy to .env and fill in. Never commit .env.
# Get a key from https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Verified working: gemini-3.5-flash (fastest), gemini-3.6-flash, gemini-3.1-flash-lite.
# Note: gemini-2.5-flash is still advertised by the models list endpoint but
# returns 404 "no longer available to new users" on generation for newer
# accounts — see docs/sdk-spike.md.
GEMINI_MODEL=gemini-3.5-flash

DB_PATH=./data/app.db
PORT=3000
